{
  "name": "strongcare",
  "version": "1.0.0",
  "description": "Strong Care - AI-assisted Rehabilitation Monitoring Platform",
  "scripts": {
    "server": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test": "cd frontend && npm test && cd .. && npx tsx tests/algorithms.test.ts && npx tsx tests/trainingModes.test.ts && node scripts/testMultiDeviceSync.mjs && node frontend/scripts/testRegisterAndNotFound.mjs",
    "test:sync": "node scripts/testMultiDeviceSync.mjs",
    "bundle:migrations": "node scripts/bundle-migrations.mjs",
    "run:sql": "node scripts/run-sql.mjs",
    "test:http-rls": "node scripts/http-rls-proof.mjs",
    "deploy:gh-pages": "powershell -ExecutionPolicy Bypass -File ./deploy_gh_pages.ps1"
  },
  "keywords": [
    "rehabilitation",
    "ai",
    "mediapipe",
    "pose-detection",
    "biomechanics",
    "face-recognition",
    "liveness-detection",
    "healthcare",
    "physical-therapy"
  ],
  "author": "Strong Care Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
